# =====================================================
# TrustShare Environment Configuration Template
# Copy this file to .env and fill in your actual values
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# Option 1: Use DATABASE_URL (recommended for production)
DATABASE_URL=postgresql://username:password@localhost:5432/trustshare

# Option 2: Use individual database variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustshare
DB_USER=your_username
DB_PASSWORD=your_password

# =====================================================
# FRONTEND URL
# =====================================================
FRONTEND_URL=http://localhost:3000

# =====================================================
# JWT CONFIGURATION
# =====================================================
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =====================================================
# AWS S3 CONFIGURATION (for cloud storage)
# =====================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=trustshare-files

# =====================================================
# AZURE BLOB STORAGE CONFIGURATION (alternative to S3)
# =====================================================
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_CONTAINER_NAME=trustshare-files

# =====================================================
# REDIS CONFIGURATION (for caching and sessions)
# =====================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =====================================================
# MONGODB CONFIGURATION (for activity logs)
# =====================================================
MONGODB_URI=mongodb://localhost:27017/trustshare_logs
MONGODB_DATABASE=trustshare_logs

# =====================================================
# ENCRYPTION CONFIGURATION
# =====================================================
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# =====================================================
# FILE UPLOAD CONFIGURATION
# =====================================================
MAX_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,csv,zip,rar,png,jpg,jpeg,gif

# =====================================================
# EMAIL CONFIGURATION (for notifications)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@trustshare.com

# =====================================================
# OAUTH2 CONFIGURATION
# =====================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# =====================================================
# SECURITY CONFIGURATION
# =====================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
