# ═══════════════════════════════════════════════════════════════════════════
# TrustShare — Environment Configuration
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════════════════

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://trustshare:trustshare@localhost:5432/trustshare

# ── JWT Secret ────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-value

# ── Master Encryption Key ─────────────────────────────────────────────────────
MASTER_KEY_HEX=replace-with-64-character-hex-value

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS Origins ──────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Microsoft OAuth2 ──────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# ── Dashboard Seed ────────────────────────────────────────────────────────────
DASHBOARD_SEED_ON_STARTUP=true

# ── Storage Backend ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local

# ── AWS S3 (future) ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=trustshare-files
AWS_S3_PREFIX=encrypted/

# ── MongoDB (optional) ────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=trustshare
MONGODB_COLLECTION=security_activity_logs

# ── AI File Summaries (optional) ─────────────────────────────────────────────
AI_SUMMARY_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
HF_API_TOKEN=
HF_SUMMARY_MODEL=
ALLOW_EXTERNAL_AI=false
ENABLE_SUMMARY_FALLBACK=true
SUMMARY_MAX_FILE_SIZE_MB=20
SUMMARY_MAX_EXTRACTED_CHARACTERS=120000
SUMMARY_CHUNK_SIZE=12000
SUMMARY_CHUNK_OVERLAP=500
SUMMARY_REQUEST_TIMEOUT_SECONDS=90