ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://trustshare:trustshare@localhost:5432/trustshare
SECRET_KEY=replace-with-a-long-random-value
# Generate a 64-character hex key with:
# python -c "import secrets; print(secrets.token_bytes(32).hex())"
MASTER_KEY_HEX=<64_character_hex_here>

# AI file summaries (Ollama is local and free)
AI_SUMMARY_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
HF_API_TOKEN=
HF_SUMMARY_MODEL=
ALLOW_EXTERNAL_AI=false
ENABLE_SUMMARY_FALLBACK=true
SUMMARY_MAX_FILE_SIZE_MB=5
SUMMARY_MAX_EXTRACTED_CHARACTERS=120000
SUMMARY_CHUNK_SIZE=12000
SUMMARY_CHUNK_OVERLAP=500
SUMMARY_REQUEST_TIMEOUT_SECONDS=90
