# ── JWT ──────────────────────────────────────────────────────────────────────
SECRET_KEY=trustshare-super-secret-key-change-in-prod-2026

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google-client-secret

# ── Microsoft OAuth2 ──────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# ── Database & Server ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sql_app.db
DASHBOARD_SEED_ON_STARTUP=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Generate one with:
# python -c "import secrets; print(secrets.token_bytes(32).hex())"
# Master key for encrypting file keys (32 bytes hex = 64 chars)
MASTER_KEY_HEX=generate-it-by-terminal-use-above-command
